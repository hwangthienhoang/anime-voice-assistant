# Copy file này thành .env rồi điền key của bạn (KHÔNG commit file .env)
ANTHROPIC_API_KEY=sk-ant-...

# Model dùng cho hội thoại
ANTHROPIC_MODEL=claude-sonnet-5

# Giọng đọc của Edge TTS. Xem danh sách: `edge-tts --list-voices`
#   vi-VN-HoaiMyNeural (nữ), vi-VN-NamMinhNeural (nam)
TTS_VOICE=vi-VN-HoaiMyNeural

# Độ dài tối đa của mỗi câu trả lời (token). Giữ nhỏ để phản hồi nhanh.
MAX_TOKENS=400
